# Server
PORT=8787

# URL where this backend is publicly reachable over HTTPS.
# Example: https://dpt-detector-api.example.com
PUBLIC_BACKEND_URL=https://YOUR-BACKEND-DOMAIN

# Browser frontend URL. Use * for local development only.
FRONTEND_ORIGIN=http://localhost:8787

# Copyleaks credentials
COPYLEAKS_EMAIL=your-copyleaks-account-email
COPYLEAKS_API_KEY=your-copyleaks-api-key
COPYLEAKS_SANDBOX=false

# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5.6
