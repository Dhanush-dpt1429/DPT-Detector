# Server
PORT=8787

# Public Vercel URL used by Copyleaks webhooks
PUBLIC_BACKEND_URL=https://dpt-detector.vercel.app

# Browser origin allowed to call the API
FRONTEND_ORIGIN=https://dpt-detector.vercel.app

# Copyleaks
COPYLEAKS_EMAIL=your-copyleaks-account-email
COPYLEAKS_API_KEY=your-copyleaks-api-key
COPYLEAKS_SANDBOX=true

# Upstash Redis
UPSTASH_REDIS_REST_URL=your-upstash-rest-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
